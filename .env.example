# Variables publiques, exposées au navigateur.
# URL d'API du projet, pas l'adresse du tableau de bord.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC.
# Ne jamais commiter la valeur réelle : ce fichier est versionné.
# La clé sb_secret_ contourne la RLS et ne doit pas être utilisée par le client.
SUPABASE_SECRET_KEY=
